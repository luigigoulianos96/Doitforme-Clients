{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/storage/presign-upload", "destination": "/api/storage/presign-upload.js" },
    { "source": "/api/storage/delete", "destination": "/api/storage/delete.js" },
    { "source": "/api/push/vapid-public-key", "destination": "/api/push/vapid-public-key.js" },
    { "source": "/api/push/subscribe", "destination": "/api/push/subscribe.js" },
    { "source": "/api/push/notify-review-event", "destination": "/api/push/notify-review-event.js" },
    { "source": "/", "destination": "/public/portal.html" },
    { "source": "/portal", "destination": "/public/portal.html" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/index", "destination": "/public/index.html" },
    { "source": "/portal.html", "destination": "/public/portal.html" },
    { "source": "/admin.html", "destination": "/public/admin.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/portal.js", "destination": "/public/portal.js" },
    { "source": "/admin.js", "destination": "/public/admin.js" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/config.js", "destination": "/public/config.js" },
    { "source": "/service-worker.js", "destination": "/public/service-worker.js" },
    { "source": "/service-worker-icon.svg", "destination": "/public/service-worker-icon.svg" },
    { "source": "/sw.js", "destination": "/public/sw.js" },
    { "source": "/admin/(.*)", "destination": "/public/admin/$1" },
    { "source": "/components/(.*)", "destination": "/public/components/$1" },
    { "source": "/core/(.*)", "destination": "/public/core/$1" },
    { "source": "/hooks/(.*)", "destination": "/public/hooks/$1" },
    { "source": "/services/(.*)", "destination": "/public/services/$1" },
    { "source": "/utils/(.*)", "destination": "/public/utils/$1" }
  ]
}
